# Solana mainnet RPC. Production needs transaction-history/archive access.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Public launch readiness rejects the shared api.mainnet-beta.solana.com endpoint.
# Use a dedicated provider with transaction-history/archive support.
SOLANA_DISCOVERY_MAX_PAGES=20
ZAPP_SOLANA_WATCHER_ENABLED=false
ZAPP_SOLANA_WATCH_MAX_PAGES=20
# Optional override for the readiness transaction-history probe.
ZAPP_SOLANA_HISTORY_PROBE_SIGNATURE=

# PostgreSQL is mandatory. ZApp never uses ephemeral memory as canonical uniqueness state.
DATABASE_URL=postgres://zapp:zapp@localhost:5432/zapp
DATABASE_SSL=disable

# Optional sponsored-relay fee, paid inside the same Solana burn transaction.
# Public and server values MUST match. Keep all four blank/zero to disable.
ZAPP_FEE_LAMPORTS=0
ZAPP_FEE_TREASURY=
NEXT_PUBLIC_ZAPP_FEE_LAMPORTS=0
NEXT_PUBLIC_ZAPP_FEE_TREASURY=

# Zcash mainnet zcashd JSON-RPC.
# The v1 relay isolates legacy raw-transaction RPC usage in src/lib/server/zcash.ts.
ZCASH_RPC_URL=http://127.0.0.1:8232
# When using docker compose and zcashd is on the host:
ZCASH_DOCKER_RPC_URL=http://host.docker.internal:8232
ZCASH_RPC_USER=
ZCASH_RPC_PASSWORD=

# Transparent marker output delivered to the destination committed on Solana.
ZCASH_MARKER_ZATS=546
ZCASH_MIN_CONFIRMATIONS=1

# Optional explicit starting block. Leave blank to auto-start with a 1,000-block safety window.
ZAPP_ZCASH_START_HEIGHT=
ZAPP_INDEXER_ENABLED=false

# Public launchpad policy
# Keep both false until `npm run preflight` passes against production.
ZAPP_PUBLIC_LAUNCH_ENABLED=false
NEXT_PUBLIC_ZAPP_PUBLIC_LAUNCH_ENABLED=false
ZAPP_REQUIRE_REGISTERED_ASSET=true
ZAPP_NFT_MINT_ENABLED=true

# Dedicated transparent wallet key used only to authorize inscription reveals.
# Must be a wallet-owned compressed t1 address. The web process does not need this value.
ZAPP_NFT_SIGNER_TADDR=
ZAPP_NFT_POSTAGE_ZATS=546
# Optional floor only. ZApp calculates the ZIP-317 conventional reveal fee itself.
ZAPP_NFT_REVEAL_FEE_ZATS=0
ZAPP_INSCRIPTION_SIGNER_BIN=native/zapp-zcash-signer/target/release/zapp-zcash-signer

# Readiness gate
ZAPP_MIN_RELAY_BALANCE_ZEC=0.01


# Canonical public origin. Set this to the permanent custom domain before public token creation,
# because ZApp-created SPL tokens embed /api/metadata/<mint> immutably in Metaplex metadata.
NEXT_PUBLIC_APP_URL=https://zapp.example
ZAPP_CANONICAL_ORIGIN=https://zapp.example

# Secret salt for privacy-preserving DB-backed API rate-limit buckets.
ZAPP_RATE_LIMIT_SECRET=replace-with-a-long-random-secret


# Private mainnet canary console. Keep disabled except during the controlled canary.
# Generate a long random secret and access /canary; the secret becomes an HttpOnly
# 2-hour session and is never stored in browser JavaScript.
ZAPP_CANARY_ENABLED=false
ZAPP_CANARY_SECRET=
