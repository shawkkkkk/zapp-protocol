# Solana mainnet RPC. Production needs transaction-history/archive access.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_DISCOVERY_MAX_PAGES=20

# PostgreSQL is mandatory. ZApp never uses ephemeral memory as canonical uniqueness state.
DATABASE_URL=postgres://zapp:zapp@localhost:5432/zapp
DATABASE_SSL=disable

# Optional sponsored-relay fee, paid inside the same Solana burn transaction.
# Public and server values MUST match. Keep all four blank/zero to disable.
ZAPP_FEE_LAMPORTS=0
ZAPP_FEE_TREASURY=
NEXT_PUBLIC_ZAPP_FEE_LAMPORTS=0
NEXT_PUBLIC_ZAPP_FEE_TREASURY=

# Set false for verification/indexer-only deployments.
ZAPP_RELAY_ENABLED=true

# Zcash mainnet zcashd JSON-RPC.
# The v1 relay isolates legacy raw-transaction RPC usage in src/lib/server/zcash.ts.
ZCASH_RPC_URL=http://127.0.0.1:8232
ZCASH_RPC_USER=
ZCASH_RPC_PASSWORD=

# Transparent marker output delivered to the destination committed on Solana.
ZCASH_MARKER_ZATS=1000
ZCASH_MIN_CONFIRMATIONS=1

# Set to the block immediately BEFORE the first production ZApp Proof.
ZAPP_ZCASH_START_HEIGHT=0
