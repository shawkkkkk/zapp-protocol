# Solana mainnet RPC. Use a provider with transaction-history access in production.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_DISCOVERY_MAX_PAGES=20

# PostgreSQL is mandatory for relay mode. ZApp fails closed without durable uniqueness state.
DATABASE_URL=postgres://zapp:zapp@localhost:5432/zapp

# Zcash mainnet zcashd JSON-RPC. The relay currently uses the legacy raw-transaction RPCs.
# Start zcashd with wallet support and allowdeprecated=createrawtransaction,
# allowdeprecated=fundrawtransaction,allowdeprecated=signrawtransaction.
ZCASH_RPC_URL=http://127.0.0.1:8232
ZCASH_RPC_USER=
ZCASH_RPC_PASSWORD=

# Marker output sent to the destination t-address. 0.00001 ZEC = 1000 zatoshis.
ZCASH_MARKER_VALUE_ZEC=0.00001
ZCASH_MIN_CONFIRMATIONS=1

# Indexer start height. Set this to the block before ZApp's first production STAMP.
ZAPP_ZCASH_START_HEIGHT=0
